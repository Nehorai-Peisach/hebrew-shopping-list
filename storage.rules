rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to read and write their own images
    match /items/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow anyone to read from public paths (for shared URLs)
    match /items/{allPaths=**} {
      allow read: if true;
    }
  }
}
